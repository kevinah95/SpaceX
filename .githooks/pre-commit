#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(git rev-parse --show-toplevel)"
cd "$ROOT_DIR"

STAGED_FILES="$(git diff --cached --name-only --diff-filter=ACMR)"
if [[ -z "$STAGED_FILES" ]]; then
  exit 0
fi

# Filter to files that Spotless handles
STAGED_FORMAT_FILES=$(echo "$STAGED_FILES" | grep -E '\.(kt|kts|json|yaml|yml)$' || true)
if [[ -z "$STAGED_FORMAT_FILES" ]]; then
  exit 0
fi

# Prepare a comma-separated list of regexes for Spotless (e.g. .*path/to/file1.kt,.*path/to/file2.kts)
SPOTLESS_FILES_ARG=$(echo "$STAGED_FORMAT_FILES" | sed 's/^/.*/' | paste -sd, -)

echo "Running Spotless checks on staged files..."
# Unset Git environment variables to prevent Gradle configuration cache invalidation
if env -u GIT_INDEX_FILE -u GIT_DIR -u GIT_WORK_TREE -u GIT_PREFIX app/gradlew -p app spotlessCheck "-PspotlessFiles=$SPOTLESS_FILES_ARG"; then
  exit 0
fi

echo "Formatting issues found. Running spotlessApply on staged files..."
env -u GIT_INDEX_FILE -u GIT_DIR -u GIT_WORK_TREE -u GIT_PREFIX app/gradlew -p app spotlessApply "-PspotlessFiles=$SPOTLESS_FILES_ARG"

# Safely re-stage only the files that were modified by spotless
echo "$STAGED_FORMAT_FILES" | while read -r file; do
  if [[ -f "$file" ]]; then
    git add "$file"
  fi
done

echo "Spotless applied fixes and re-staged files."
echo "Review changes and run commit again."
exit 1

