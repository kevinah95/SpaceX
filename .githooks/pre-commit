#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(git rev-parse --show-toplevel)"
cd "$ROOT_DIR"

STAGED_FILES="$(git diff --cached --name-only --diff-filter=ACMR)"
if [[ -z "$STAGED_FILES" ]]; then
  exit 0
fi

if ! echo "$STAGED_FILES" | grep -Eq '\.(kt|kts|json|yaml|yml)$'; then
  exit 0
fi

echo "Running Spotless checks on commit..."
if ./gradlew spotlessCheck; then
  exit 0
fi

echo "Formatting issues found. Running spotlessApply..."
./gradlew spotlessApply

git add -A

echo "Spotless applied fixes and re-staged files."
echo "Review changes and run commit again."
exit 1
