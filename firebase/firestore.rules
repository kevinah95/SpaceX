rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // SpaceX Launches: readable and writable by authenticated users.
    match /launches/{launchId} {
      allow read, write: if request.auth != null;
    }

    // Metadata: readable and writable by authenticated users.
    match /metadata/{docId} {
      allow read, write: if request.auth != null;
    }
    
    // Fallback security rule: Deny all other access to teach safe defaults.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
