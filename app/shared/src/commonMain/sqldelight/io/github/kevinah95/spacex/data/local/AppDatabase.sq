import kotlin.Boolean;

CREATE TABLE Launch (
    id TEXT NOT NULL,
    missionName TEXT NOT NULL,
    details TEXT,
    launchSuccess INTEGER AS Boolean DEFAULT NULL,
    launchDateUTC TEXT NOT NULL,
    patchUrlSmall TEXT,
    patchUrlLarge TEXT,
    articleUrl TEXT
);

CREATE TABLE AppMetadata (
    key TEXT NOT NULL PRIMARY KEY,
    value TEXT NOT NULL
);

insertLaunch:
INSERT INTO Launch(id, missionName, details, launchSuccess, launchDateUTC, patchUrlSmall, patchUrlLarge, articleUrl)
VALUES(?, ?, ?, ?, ?, ?, ?, ?);

removeAllLaunches:
DELETE FROM Launch;

selectAllLaunchesInfo:
SELECT Launch.*
FROM Launch;

getMetadata:
SELECT value FROM AppMetadata WHERE key = ?;

upsertMetadata:
INSERT OR REPLACE INTO AppMetadata(key, value) VALUES(?, ?);